<Window x:Class="PavlovReplayViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pavlov Replay Viewer" 
        Height="800" Width="1400"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="5">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="LoadButton" Content="📂 Load Replay" Click="LoadButton_Click"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0"/>
                <Button x:Name="PlayPauseButton" Content="▶ Play" Click="PlayPauseButton_Click" IsEnabled="False"/>
                <Button x:Name="StopButton" Content="⏹ Stop" Click="StopButton_Click" IsEnabled="False"/>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0"/>
                <TextBlock Text="Speed:" VerticalAlignment="Center" Margin="5,0"/>
                <ComboBox x:Name="SpeedComboBox" Width="80" SelectedIndex="2" SelectionChanged="SpeedComboBox_SelectionChanged">
                    <ComboBoxItem Content="0.25x"/>
                    <ComboBoxItem Content="0.5x"/>
                    <ComboBoxItem Content="1x"/>
                    <ComboBoxItem Content="2x"/>
                    <ComboBoxItem Content="4x"/>
                </ComboBox>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0"/>
                <TextBlock x:Name="FileNameText" Text="No file loaded" VerticalAlignment="Center" Foreground="#AAAAAA"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Panel - Game Info and Players -->
            <Border Grid.Column="0" Background="#252526" Margin="5">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <!-- Game Info -->
                        <TextBlock Text="GAME INFO" FontWeight="Bold" FontSize="14" Foreground="#569CD6" Margin="0,0,0,10"/>
                        <Border Background="#1E1E1E" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock x:Name="GameModeText" Text="Mode: -" Foreground="#DCDCDC"/>
                                <TextBlock x:Name="DurationText" Text="Duration: -" Foreground="#DCDCDC"/>
                                <TextBlock x:Name="MapText" Text="Map: -" Foreground="#DCDCDC"/>
                                
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#3A6EA5" CornerRadius="3" Padding="10,5">
                                        <TextBlock x:Name="Team0ScoreText" Text="0" FontSize="24" FontWeight="Bold" 
                                                   HorizontalAlignment="Center" Foreground="White"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="vs" FontSize="16" Foreground="#888888" 
                                               VerticalAlignment="Center" Margin="10,0"/>
                                    <Border Grid.Column="2" Background="#A53A3A" CornerRadius="3" Padding="10,5">
                                        <TextBlock x:Name="Team1ScoreText" Text="0" FontSize="24" FontWeight="Bold" 
                                                   HorizontalAlignment="Center" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <!-- Team 0 Players -->
                        <TextBlock Text="TEAM 0 (Blue)" FontWeight="Bold" FontSize="14" Foreground="#569CD6" Margin="0,0,0,5"/>
                        <ItemsControl x:Name="Team0PlayersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E1E" CornerRadius="3" Padding="8" Margin="0,0,0,3"
                                            BorderBrush="#3A6EA5" BorderThickness="2,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PlayerName}" Foreground="#DCDCDC" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Foreground="#888888">
                                                <Run Text="{Binding Kills, Mode=OneWay}"/>/<Run Text="{Binding Deaths, Mode=OneWay}"/>/<Run Text="{Binding Assists, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Team 1 Players -->
                        <TextBlock Text="TEAM 1 (Red)" FontWeight="Bold" FontSize="14" Foreground="#CE9178" Margin="0,15,0,5"/>
                        <ItemsControl x:Name="Team1PlayersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E1E" CornerRadius="3" Padding="8" Margin="0,0,0,3"
                                            BorderBrush="#A53A3A" BorderThickness="2,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PlayerName}" Foreground="#DCDCDC" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Foreground="#888888">
                                                <Run Text="{Binding Kills, Mode=OneWay}"/>/<Run Text="{Binding Deaths, Mode=OneWay}"/>/<Run Text="{Binding Assists, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top: Interactive 2D Map -->
                <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="5" Padding="8" Margin="0,0,0,10">
                    <Grid>
                        <TextBlock Text="MAP" FontWeight="Bold" FontSize="14" Foreground="#569CD6" Margin="0,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Border Background="#111" BorderBrush="#333" BorderThickness="1" Margin="0,24,0,0" ClipToBounds="True">
                            <Grid>
                                <ScrollViewer x:Name="MapScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Canvas x:Name="MapCanvas" Width="2000" Height="2000" Background="#101010" MouseWheel="MapCanvas_MouseWheel" MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown" MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp" MouseMove="MapCanvas_MouseMove" />
                                </ScrollViewer>
                                <TextBlock x:Name="MapInfoText" Text="Zoom: 100% - Drag to pan (use mouse wheel to zoom). Click marker to center." Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Bottom: Event Log -->
                <Border Grid.Row="1" Background="#252526">
                    <StackPanel Margin="10">
                        <TextBlock Text="EVENTS" FontWeight="Bold" FontSize="14" Foreground="#569CD6" Margin="0,0,0,10"/>
                        <ListBox x:Name="EventsList" Background="#1E1E1E" Foreground="#DCDCDC" 
                                 BorderBrush="#3E3E40"
                                 SelectionChanged="EventsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TimeFormatted}" Foreground="#888888" Width="50"/>
                                        <TextBlock Text="{Binding EventType}" Foreground="#569CD6" Width="60"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#DCDCDC"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        
        <!-- Bottom - Timeline Scrubber -->
        <Border Grid.Row="2" Background="#2D2D30" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="CurrentTimeLabelStart" Text="0:00" Grid.Column="0" 
                           VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#AAAAAA"/>
                
                <Slider x:Name="TimelineSlider" Grid.Column="1" 
                        Minimum="0" Maximum="100" Value="0"
                        IsEnabled="False"
                        ValueChanged="TimelineSlider_ValueChanged"
                        Margin="10,0"/>
                
                <TextBlock x:Name="CurrentTimeLabelEnd" Text="0:00" Grid.Column="2" 
                           VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#AAAAAA"/>
            </Grid>
        </Border>
    </Grid>
</Window>
